# Local development PostgreSQL. Production credentials must be supplied outside the repository.
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:55432/marketplace
# Separate disposable database for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:55432/marketplace_test
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
